# 仅作字段说明。部署时由安装脚本生成真实值，权限为 600。
AIRPORT_BIND_HOST=127.0.0.1
AIRPORT_PORT=18080
AIRPORT_DATA_DIR=/var/lib/airport-monitor
AIRPORT_RUNTIME_DIR=/run/airport-monitor
AIRPORT_LOG_DIR=/var/log/airport-monitor
AIRPORT_SING_BOX=/opt/airport-monitor/bin/sing-box
AIRPORT_ENCRYPTION_KEY=由安装脚本生成
AIRPORT_SESSION_PEPPER=由安装脚本生成
AIRPORT_ALLOWED_HOSTS=localhost,127.0.0.1
AIRPORT_LOG_LEVEL=INFO
AIRPORT_HARDWARE_CPU=例如 Intel Core i7-8700T ES
AIRPORT_HARDWARE_MEMORY=例如 DDR4-2666 8 GB × 2
AIRPORT_HARDWARE_DISK=例如 英睿达 MX500 500 GB
